{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/solid/*": ["./src/components/solidjs/*"],
      "*": ["./*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
