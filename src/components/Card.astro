---
import { Image } from 'astro:assets'
import FormattedDate from './FormattedDate.astro'
import Link from './Link.astro'
import { useTranslations } from '@/i18n'

const t = useTranslations()

interface Props {
  index?: number // The index of the card in the list.
  title: string
  date?: number | string
  location?: string
  description: string
  imgSrc?: ImageMetadata | string // @todo Fix the error message.
  imgType?: string
  href?: string
}

const { index, title, date, location, description, imgSrc, imgType, href } =
  Astro.props
---

<div
  class:list={`${imgSrc ? 'h-full' : ''} group bg-primary-100 hover:bg-primary-200 relative overflow-hidden rounded-lg transition motion-reduce:transition-none dark:bg-gray-900 hover:dark:bg-gray-800`}
>
  {
    imgSrc && (
      <div class="relative">
        {/* @ts-ignore */}
        <Image
          alt={title}
          src={imgSrc}
          class:list={[
            'aspect-[21/9] w-full object-cover object-center transition group-hover:scale-105 motion-reduce:group-hover:transform-none',
            { pixelated: imgType === 'pixelated' },
          ]}
          width={720}
          height={405}
          format={imgType === 'pixelated' ? 'png' : 'webp'}
          loading={index !== undefined && index <= 1 ? 'eager' : 'lazy'}
        />
        {date && (
          <dl>
            <dt class="sr-only">{t('components.cards.publishedIn')}</dt>
            <dd class="absolute right-1 bottom-1 z-10 m-1 rounded-md bg-gray-950 px-2 py-0 text-sm leading-6 font-medium text-gray-50">
              <FormattedDate {date} />
            </dd>
          </dl>
        )}
      </div>
    )
  }
  <div class="p-6 pt-3">
    {
      location && (
        <p class="prose flex items-center gap-x-1 pt-2 pb-0 text-sm text-gray-500 dark:text-gray-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            class="size-4"
          >
            <path
              fill-rule="evenodd"
              d="m7.539 14.841.003.003.002.002a.755.755 0 0 0 .912 0l.002-.002.003-.003.012-.009a5.57 5.57 0 0 0 .19-.153 15.588 15.588 0 0 0 2.046-2.082c1.101-1.362 2.291-3.342 2.291-5.597A5 5 0 0 0 3 7c0 2.255 1.19 4.235 2.292 5.597a15.591 15.591 0 0 0 2.046 2.082 8.916 8.916 0 0 0 .189.153l.012.01ZM8 8.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
              clip-rule="evenodd"
            />
          </svg>
          <span>{location}</span>
        </p>
      )
    }
    <h3
      class="dark:text-primary-100 py-3 text-2xl leading-8 font-bold tracking-tight text-gray-900"
    >
      {
        href ? (
          <Link
            href={href}
            aria-label={t('components.card.linkToPost', { title })}
          >
            {title}
          </Link>
        ) : (
          title
        )
      }
    </h3>
    <p class="prose max-w-none text-gray-900 dark:text-gray-100">
      {description}
    </p>
    {
      href && (
        <Link
          href={href}
          class="themed-link group-hover:text-primary-800 dark:group-hover:text-primary-300 pointer-events-auto text-base leading-6 font-medium transition after:absolute after:inset-0"
          aria-label={t('components.card.linkToPost', { title })}
        />
      )
    }
    {
      !imgSrc && date && (
        <dl>
          <dt class="sr-only">{t('components.cards.publishedIn')}</dt>
          <dd class="absolute right-1 bottom-1 z-10 m-1 rounded-md bg-gray-950 px-2 py-0 text-sm leading-6 font-medium text-gray-50">
            <FormattedDate {date} />
          </dd>
        </dl>
      )
    }
  </div>
</div>
